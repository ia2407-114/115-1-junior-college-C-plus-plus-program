#include<stdio.h>
int main(void)
{
	double money, rate, goal, sum;
	int year = 0;
	double total = 0;
	printf("請輸入本金、利息、存款目標：\n");
	scanf_s("%lf %lf %lf", &money, &rate, &goal);
	sum = money;
	while (sum < goal)
	{
		year++;
		sum = money;
		for (int i = 1; i <= year; i++)
		{
			sum = sum * (1 + rate);
		}
		printf("第%d年本利合為：%.2lf\n", year, sum);
	}
	printf("第%d年後可以達成目標\n", year);
	return 0;
}

