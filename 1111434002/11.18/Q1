#include <stdio.h>
#define SIZE 10
void sort(int num[], int length, int f);
int main(void)
{
	int num[SIZE] = { 0 };
	int flag;
	printf("請輸入10筆資料\n");
	for (int i = 0; i < SIZE; i++)
	{
		scanf_s("%d", &num[i]);
	}
	for (int i = 0; i < SIZE; i++)
	{
		printf("%d ", num[i]);
	}
	printf("請輸入旗標0：由大到小、1：由小到大\n");
	scanf_s("%d", &flag);
	sort(num, SIZE, flag);
	return 0;
}
void sort(int num[], int length, int flag)
{
	int temp;
	for (int i = 0; i < length - 1; i++)
	{
		for (int j = 0; j < length - 1; j++)
		{
			if (flag == 0)
			{
				if (num[j] < num[j + 1])
				{
					temp = num[j + 1];
					num[j + 1] = num[j];
					num[j] = temp;
				}

			}
			else if (flag == 1)
			{
				if (num[j] > num[j + 1])
				{
					temp = num[j];
					num[j] = num[j + 1];
					num[j + 1] = temp;
				}
			}
		}

	}
	printf("排序後結果：\n");
	for (int i = 0; i < length; i++)
	{
		printf("%d ", num[i]);
	}
}
