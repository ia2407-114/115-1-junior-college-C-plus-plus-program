void sort_array(int students[][SCORE], int n, int flag1)
{
    int temp;
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n - 1; j++)
        {
            if (flag1 == 0)
            {
                if (students[j][0] < students[j + 1][0])
                {
                    temp = students[j + 1][0];
                    students[j + 1][0] = students[j][0];
                    students[j][0] = temp;

                    temp = students[j + 1][1];
                    students[j + 1][1] = students[j][1];
                    students[j][1] = temp;

                    temp = students[j + 1][2];
                    students[j + 1][2] = students[j][2];
                    students[j][2] = temp;
                }
            }
            else if (flag1 == 1)
            {
                if (students[j][0] > students[j + 1][0])
                {
                    temp = students[j][0];
                    students[j][0] = students[j + 1][0];
                    students[j + 1][0] = temp;

                    temp = students[j][1];
                    students[j][1] = students[j + 1][1];
                    students[j + 1][1] = temp;

                    temp = students[j][2];
                    students[j][2] = students[j + 1][2];
                    students[j + 1][2] = temp;
                }
            }
        }

    }
    printf("排序後結果：\n");
    for (int i = 0; i < n; i++)
    {
        printf("%d / %d / %d\n", students[i][0], students[i][1], students[i][2]);
    }
}   

int binary_search(int students[][SCORE], int key, int low, int high) 
{
    int num = 0;
    if (students[low][0] < students[high][0])
    {
        num = 1;
    }
    else
    {
        num = 2;
    }
    for (int i = 0; i <=high; i++)
    {
        if (students[i][0] == key)
            return 1;
    }
    return 0;
    int mid=0;
    while (low <= high)
    {
        mid = (low + high) / 2;

        if (students[mid][0] == key)
        {
            return 1;          
        }
        if (num == 1)
        {
           if (key > students[mid][0])
           {
               high = mid + 1;
           }
           else
           {
               low = mid + 1;
           }
        }

        else 
        {
            if (key < students[mid][0])
            {
                low = mid + 1;
            }
            else
            {
                high = mid + 1;
            }
        }
    }
    return 0; 
}
