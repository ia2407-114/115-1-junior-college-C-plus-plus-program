#include<stdio.h>
#define MAX 50
void print_func(int id[],float math[], float english[], int count);
int main(void)
{
	int id[MAX];
	float math[MAX], english[MAX];
	int count = 0;
	for (int i = 0; i < MAX; i++)
	{
		printf("請輸入學號、數學、英文\n");
		scanf_s("%d %f %f", &id[i], &math[i], &english[i]);
		if (id[i] == 999)
			break;
		count++;
	}
	print_func(id, math, english,  count);
	return 0;
}
void print_func(int id[], float math[], float english[], int count)
{
	printf("\n學生成績報表：\n");
	for (int i = 0; i < count; i++)
	{
		printf("學號%d：\n數學成績為%f\n英文成績為%f\n", id[i], math[i], english[i]);
	}
}

