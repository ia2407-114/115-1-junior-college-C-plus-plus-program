void printData(int data[][ColLen],int len) {
	printf("ID\t數學\t英文\n");
	for (int i = 0; i < len; i++)
	{
		for (int j = 0; j < ColLen; j++)
		{
			printf("%d\t", data[i][j]);
		}
		puts("");
	}
}
void array_sort(int data[][ColLen],int dataLen,int orderBy,bool flag) {
	bool isSwap = true;
	while (isSwap) {
		isSwap = false;
		for (size_t i = 0; i < dataLen - 1; ++i) {
			bool cmp = flag ? 
				data[i][orderBy] > data[i + 1][orderBy]:
				data[i][orderBy] < data[i + 1][orderBy];
			if (cmp) {
				isSwap = true;
				dataSwap(data[i], data[i + 1],ColLen);
			}
		}
	}
}
void dataSwap(int pa[ColLen], int pb[ColLen],int len) {
	for (int i = 0; i < len; i++)
	{
		int tmp = pa[i];
		pa[i] = pb[i];
		pb[i] = tmp;
	}

}




