#include <stdio.h>
#define ROWS 10
#define IDD 3

int linear_search(int data[][IDD], int len, int key);

int main(void)
{
    int ST[ROWS][IDD] = {
        {1, 85, 90},
        {2, 72, 68},
        {3, 95, 88},
        {4, 60, 75},
        {5, 78, 82},
        {6, 91, 94},
        {7, 66, 70},
        {8, 84, 79},
        {9, 88, 85},
        {10, 73, 80}
    
    };
    int Key;
    int flag;

    puts("原始學生成績資料:");
    printf("%4s %4s %4s\n", "學號", "數學", "英文");
    puts("-----------------");
    for (int i = 0; i < ROWS; ++i) {
        printf("%4d %4d %4d\n", ST[i][0], ST[i][1], ST[i][2]);
    }

    printf("輸入要查詢的學生學號：");
    scanf_s("%d", &Key);

    flag = linear_search(ST, ROWS, Key);

    if (flag == 1) {
        puts("\n找到該筆學生資料:");
        printf("%4s %4s %4s\n", "學號", "數學", "英文");
        puts("------------------------------------------");
        for (int i = 0; i < ROWS; ++i) {
            if (ST[i][0] == Key) {
                printf("%4d %4d %4d\n", ST[i][0], ST[i][1], ST[i][2]);
            }
        }
    }
    else {
        printf("\n找不到資料！\n");
    }
    return 0;
}

int linear_search( int data[][IDD], int len, int key)
{
    for (int i = 0; i < len; ++i) {
        if (data[i][0] == key) {
            return 1;
        }
    }
    return 0; 
}